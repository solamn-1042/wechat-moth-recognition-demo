.container {
    min-height: 100vh;
    background: #f6f9f8;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 30rpx;
  }
  .header {
    width: 100%;
    padding: 60rpx 0 24rpx 0;
    background: #4fc08d;
    text-align: center;
    border-radius: 0 0 32rpx 32rpx;
    margin-bottom: 30rpx;
  }
  .title {
    font-size: 44rpx;
    color: #fff;
    font-weight: bold;
  }
  .user-section {
    width: 90%;
    margin: 32rpx 0 24rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .user-info {
    display: flex;
    align-items: center;
  }
  .avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    margin-right: 18rpx;
  }
  .nickname {
    font-size: 32rpx;
    color: #333;
  }
  .login-btn {
    width: 200rpx;
    height: 72rpx;
    background: #4fc08d;
    color: #fff;
    border-radius: 36rpx;
    font-size: 32rpx;
    margin-bottom: 12rpx;
  }
  .login-tip {
    font-size: 24rpx;
    color: #bbb;
  }
  .action-area {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 28rpx;
    width: 90%;
    margin-bottom: 24rpx;
  }
  .action-btn {
    flex: 1;
    padding: 20rpx 0;
    background: #fff;
    color: #4fc08d;
    border: 2rpx solid #4fc08d;
    border-radius: 24rpx;
    font-size: 32rpx;
    margin: 0 8rpx;
    transition: background 0.2s;
  }
  .action-btn:active {
    background: #e0f4eb;
  }
  .demo-box {
    width: 90%;
    background: #fff;
    border-radius: 24rpx;
    box-shadow: 0 2rpx 12rpx 0 #d7e4e1;
    padding: 32rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 36rpx;
  }
  .demo-box image {
    width: 440rpx;
    height: 330rpx;
    border-radius: 16rpx;
    margin-bottom: 16rpx;
    background: #f2f2f2;
  }
  .info-section {
    width: 90%;
    background: #fff;
    border-radius: 24rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 12rpx 0 #d7e4e1;
    margin-bottom: 36rpx;
  }
  .section-header {
    margin-bottom: 14rpx;
  }
  .section-title {
    font-size: 30rpx;
    color: #333;
    font-weight: bold;
  }
  .section-content {
    color: #555;
    font-size: 26rpx;
    line-height: 1.7;
  }
  .info-item {
    display: block;
    margin-bottom: 8rpx;
  }
  .footer {
    width: 100%;
    text-align: center;
    color: #a3a3a3;
    font-size: 24rpx;
    margin-top: auto;
    padding: 22rpx 0 8rpx 0;
  }