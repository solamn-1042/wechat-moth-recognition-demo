.container {
    min-height: 100vh;
    background: linear-gradient(to bottom, #f6f9f8, #e9f3ef);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0 30rpx;
    box-sizing: border-box;
    position: relative;
  }
  
  /* 装饰圆 */
  .decorative-circle {
    position: absolute;
    background: rgba(79, 192, 141, 0.15);
    border-radius: 50%;
    z-index: 1;
  }
  
  .circle-1 {
    width: 300rpx;
    height: 300rpx;
    top: 10%;
    left: -10%;
  }
  
  .circle-2 {
    width: 400rpx;
    height: 400rpx;
    bottom: -5%;
    right: -15%;
    background: rgba(79, 192, 141, 0.1);
  }
  
  /* 顶部标题区 */
  .header {
    width: 100%;
    padding: 60rpx 0 30rpx;
    background: #4fc08d;
    text-align: center;
    border-radius: 0 0 32rpx 32rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 20rpx rgba(79, 192, 141, 0.3);
    z-index: 5;
  }
  
  .title {
    font-size: 44rpx;
    color: #fff;
    font-weight: bold;
    letter-spacing: 2rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  }
  
  /* 内容区域容器 */
  .content-container {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  
  /* 导航选项卡 */
  .nav-tabs {
    width: 100%;
    height: 80rpx;
    white-space: nowrap;
    background: #ffffff;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
    margin-bottom: 20rpx;
  }
  
  .tab-item {
    display: inline-block;
    height: 80rpx;
    line-height: 80rpx;
    padding: 0 28rpx;
    font-size: 28rpx;
    color: #666;
    position: relative;
    transition: all 0.3s;
  }
  
  .tab-item.active {
    color: #4fc08d;
    font-weight: 600;
  }
  
  .tab-item.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 6rpx;
    background: #4fc08d;
    border-radius: 3rpx;
  }
  
  /* 内容轮播区 */
  .content-swiper {
    width: 100%;
    height: calc(100vh - 300rpx);
  }
  
  .scroll-content {
    height: 100%;
    padding: 10rpx 30rpx 40rpx;
    box-sizing: border-box;
  }
  
  /* 飞蛾头部banner */
  .moth-banner {
    width: 100%;
    height: 300rpx;
    border-radius: 24rpx;
    overflow: hidden;
    position: relative;
    margin-bottom: 30rpx;
    box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  }
  
  .moth-banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .moth-banner-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20rpx 30rpx;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    display: flex;
    flex-direction: column;
  }
  
  .moth-name {
    font-size: 40rpx;
    font-weight: bold;
    color: #fff;
    margin-bottom: 6rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  }
  
  .moth-scientific {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.9);
    font-style: italic;
  }
  
  /* 信息卡片 */
  .info-card {
    width: 100%;
    background: #ffffff;
    border-radius: 24rpx;
    overflow: hidden;
    margin-bottom: 30rpx;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
  }
  
  .card-header {
    padding: 24rpx 30rpx;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    border-bottom: 1rpx solid #eaeaea;
  }
  
  .icon {
    font-size: 32rpx;
    margin-right: 16rpx;
  }
  
  .header-text {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
  }
  
  .card-content {
    padding: 24rpx 30rpx 30rpx;
  }
  
  .info-text {
    font-size: 28rpx;
    color: #555;
    line-height: 1.6;
    margin-bottom: 16rpx;
    display: block;
  }
  
  /* 统计数据 */
  .stats-container {
    display: flex;
    justify-content: space-between;
    margin-top: 30rpx;
    padding-top: 20rpx;
    border-top: 1rpx dashed #eaeaea;
  }
  
  .stat-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
  }
  
  .stat-value {
    font-size: 36rpx;
    font-weight: bold;
    color: #4fc08d;
    margin-bottom: 8rpx;
  }
  
  .stat-label {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 防控方法项 */
  .method-item {
    margin-bottom: 24rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx dashed #eaeaea;
  }
  
  .method-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  
  .method-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #444;
    margin-bottom: 12rpx;
    display: block;
  }
  
  /* 快速事实区域 */
  .quick-facts {
    width: 90%;
    background: rgba(79, 192, 141, 0.1);
    border-radius: 20rpx;
    padding: 24rpx 30rpx;
    margin: 20rpx 0;
    border-left: 8rpx solid #4fc08d;
  }
  
  .quick-facts-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #4fc08d;
    margin-bottom: 16rpx;
    display: block;
  }
  
  .quick-fact-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 12rpx;
  }
  
  .quick-fact-icon {
    font-size: 24rpx;
    margin-right: 12rpx;
    margin-top: 4rpx;
  }
  
  .quick-fact-text {
    font-size: 26rpx;
    color: #555;
    flex: 1;
    line-height: 1.5;
  }
  
  /* 底部区域 */
  .footer {
    width: 100%;
    text-align: center;
    padding: 30rpx 0 20rpx;
    display: flex;
    flex-direction: column;
  }
  
  .footer-text {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 6rpx;
  }
  
  .footer-copyright {
    font-size: 24rpx;
    color: #aaa;
  }