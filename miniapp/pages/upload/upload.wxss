/* pages/upload/upload.wxss */
.container {
    min-height: 100vh;
    background: linear-gradient(to bottom, #f6f9f8, #e9f3ef);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 30rpx 30rpx;
    box-sizing: border-box;
  }
  
  .header {
    width: 100%;
    padding: 60rpx 0 24rpx 0;
    background: #4fc08d;
    text-align: center;
    border-radius: 0 0 32rpx 32rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 4rpx 20rpx rgba(79, 192, 141, 0.3);
  }
  
  .title {
    font-size: 44rpx;
    color: #fff;
    font-weight: bold;
    letter-spacing: 2rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  }
  
  .image-container {
    width: 100%;
    height: 500rpx;
    background: #ffffff;
    border-radius: 24rpx;
    overflow: hidden;
    margin-bottom: 40rpx;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .preview-image {
    max-width: 100%;
    max-height: 100%;
  }
  
  .button-container, .button-group {
    width: 100%;
    display: flex;
    justify-content: space-between;
    margin-bottom: 40rpx;
  }
  
  .upload-btn, .submit-btn, .action-btn {
    width: 45%;
    height: 90rpx;
    line-height: 90rpx;
    background: #4fc08d;
    color: #ffffff;
    font-size: 32rpx;
    border-radius: 45rpx;
    box-shadow: 0 6rpx 12rpx rgba(79, 192, 141, 0.2);
  }
  
  .upload-btn {
    background: #f8f8f8;
    color: #333;
    border: 1rpx solid #e0e0e0;
    box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.05);
  }
  
  .results-container, .result-container {
    width: 100%;
    background: #ffffff;
    border-radius: 24rpx;
    overflow: hidden;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
    margin-bottom: 40rpx;
  }
  
  .result-header {
    padding: 24rpx;
    background: #f8f8f8;
    border-bottom: 1rpx solid #eaeaea;
  }
  
  .result-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
  }
  
  .main-result {
    padding: 24rpx;
  }
  
  .result-item {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .label, .result-label {
    width: 160rpx;
    font-size: 28rpx;
    color: #666;
  }
  
  .value, .result-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  
  .confidence-bar, .confidence-bar-container {
    height: 16rpx;
    background: #f2f2f2;
    border-radius: 8rpx;
    margin-top: 16rpx;
    overflow: hidden;
  }
  
  .bar-fill, .confidence-bar {
    height: 100%;
    background: #4fc08d;
    border-radius: 8rpx;
  }
  
  /* 预定义宽度的类，解决百分比动态绑定问题 */
  .width-10 { width: 10%; background-color: #ff4d4f; }
  .width-20 { width: 20%; background-color: #ff7a45; }
  .width-30 { width: 30%; background-color: #fa8c16; }
  .width-40 { width: 40%; background-color: #faad14; }
  .width-50 { width: 50%; background-color: #fadb14; }
  .width-60 { width: 60%; background-color: #a0d911; }
  .width-70 { width: 70%; background-color: #52c41a; }
  .width-80 { width: 80%; background-color: #13c2c2; }
  .width-90 { width: 90%; background-color: #1890ff; }
  .width-100 { width: 100%; background-color: #722ed1; }
  
  .other-results {
    padding: 24rpx;
    border-top: 1rpx solid #eaeaea;
  }
  
  .other-header, .other-title {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 16rpx;
    display: block;
  }
  
  .other-item {
    margin-bottom: 16rpx;
  }
  
  .other-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8rpx;
  }
  
  .other-name {
    font-size: 26rpx;
    color: #333;
  }
  
  .other-confidence {
    font-size: 26rpx;
    color: #4fc08d;
  }
  
  .confidence-bar-container.small, .confidence-bar.small {
    height: 12rpx;
  }
  
  .debug-btn {
    width: 100%;
    margin-top: 10rpx;
    background: #f0f0f0;
    color: #666;
    font-size: 24rpx;
  }