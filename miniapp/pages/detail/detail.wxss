/* pages/detail/detail.wxss */
.container {
    min-height: 100vh;
    background: linear-gradient(to bottom, #f6f9f8, #e9f3ef);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0 30rpx;
    box-sizing: border-box;
  }
  
  .detail-card {
    width: 92%;
    background: #fff;
    border-radius: 32rpx;
    margin-top: 60rpx;
    box-shadow: 0 6rpx 20rpx rgba(79, 192, 141, 0.10);
    padding: 40rpx 30rpx 30rpx 30rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .detail-header {
    width: 100%;
    text-align: center;
    margin-bottom: 30rpx;
  }
  
  .detail-title {
    font-size: 40rpx;
    color: #4fc08d;
    font-weight: bold;
    letter-spacing: 2rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  }
  
  .image-container {
    width: 90%;
    margin-bottom: 32rpx;
    display: flex;
    justify-content: center;
  }
  
  .full-image {
    width: 100%;
    border-radius: 18rpx;
    box-shadow: 0 4rpx 16rpx rgba(79, 192, 141, 0.08);
  }
  
  .detail-info {
    width: 100%;
    margin-bottom: 36rpx;
  }
  
  .info-item {
    display: flex;
    align-items: center;
    margin-bottom: 18rpx;
  }
  
  .info-label {
    font-size: 30rpx;
    color: #666;
    width: 160rpx;
    font-weight: 500;
  }
  
  .info-value {
    font-size: 30rpx;
    color: #333;
    font-weight: 600;
  }
  
  .action-buttons {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 10rpx;
  }
  
  .action-btn {
    background: #4fc08d;
    color: #fff;
    padding: 20rpx 0;
    width: 60%;
    border-radius: 45rpx;
    font-size: 32rpx;
    font-weight: 500;
    box-shadow: 0 6rpx 12rpx rgba(79, 192, 141, 0.15);
    text-align: center;
  }