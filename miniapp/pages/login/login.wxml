<view class="container">
  <view class="header">
    <text class="title">用户登录</text>
  </view>

  <!-- 装饰元素 -->
  <view class="decorative-circle circle-1"></view>
  <view class="decorative-circle circle-2"></view>

  <view class="login-form">
    <view class="form-group">
      <text class="label">用户名</text>
      <input class="input" type="text" placeholder="请输入用户名" bindinput="inputUsername" value="{{username}}"/>
    </view>
    
    <view class="form-group">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="请输入密码" bindinput="inputPassword" value="{{password}}"/>
    </view>
    
    <view class="buttons">
      <button class="submit-btn" bindtap="login">登录</button>
      <button class="register-btn" bindtap="goToRegister">注册账号</button>
    </view>
    
    <view class="return-link" bindtap="goBack">
      <text>返回首页</text>
    </view>
  </view>
</view>