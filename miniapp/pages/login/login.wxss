.container {
    min-height: 100vh;
    background: linear-gradient(to bottom, #f6f9f8, #e9f3ef);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* 使内容垂直居中 */
    padding: 0 30rpx 30rpx;
    box-sizing: border-box;
  }
  
  .header {
    width: 100%;
    padding: 60rpx 0 24rpx 0;
    background: #4fc08d;
    text-align: center;
    border-radius: 0 0 32rpx 32rpx;
    margin-bottom: 80rpx;
    box-shadow: 0 4rpx 20rpx rgba(79, 192, 141, 0.3);
    position: absolute;
    top: 0;
    left: 0;
  }
  
  .title {
    font-size: 44rpx;
    color: #fff;
    font-weight: bold;
    letter-spacing: 2rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  }
  
  .login-form {
    width: 85%;
    background: #fff;
    border-radius: 24rpx;
    padding: 50rpx 40rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
    margin-top: 120rpx;
    position: relative;
    z-index: 10;
  }
  
  .form-group {
    margin-bottom: 40rpx;
    position: relative;
  }
  
  .label {
    display: block;
    font-size: 28rpx;
    color: #555;
    margin-bottom: 16rpx;
    font-weight: 500;
  }
  
  .input {
    width: 100%;
    height: 92rpx;
    background: #f7f9f8;
    border-radius: 16rpx;
    padding: 0 28rpx;
    box-sizing: border-box;
    font-size: 30rpx;
    border: 1rpx solid #eaeaea;
    transition: all 0.3s ease;
  }
  
  .input:focus {
    border-color: #4fc08d;
    box-shadow: 0 0 0 2rpx rgba(79, 192, 141, 0.2);
  }
  
  .buttons {
    margin-top: 60rpx;
  }
  
  .submit-btn {
    width: 100%;
    height: 92rpx;
    background: linear-gradient(135deg, #4fc08d, #3da677);
    color: #fff;
    border-radius: 46rpx;
    font-size: 32rpx;
    margin-bottom: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 2rpx;
    box-shadow: 0 6rpx 12rpx rgba(79, 192, 141, 0.2);
    transition: all 0.3s ease;
    font-weight: 500;
  }
  
  .submit-btn:active {
    transform: translateY(2rpx);
    box-shadow: 0 2rpx 8rpx rgba(79, 192, 141, 0.2);
  }
  
  .register-btn {
    width: 100%;
    height: 92rpx;
    background: #fff;
    color: #4fc08d;
    border: 2rpx solid #4fc08d;
    border-radius: 46rpx;
    font-size: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .register-btn:active {
    background: #f7f9f8;
  }
  
  .return-link {
    margin-top: 50rpx;
    text-align: center;
  }
  
  .return-link text {
    color: #7a7a7a;
    font-size: 28rpx;
    padding-bottom: 2rpx;
    border-bottom: 1rpx solid #dcdcdc;
    transition: all 0.3s ease;
  }
  
  /* 装饰元素 */
  .decorative-circle {
    position: absolute;
    background: rgba(79, 192, 141, 0.15);
    border-radius: 50%;
    z-index: 1;
  }
  
  .circle-1 {
    width: 200rpx;
    height: 200rpx;
    top: 10%;
    left: 10%;
  }
  
  .circle-2 {
    width: 300rpx;
    height: 300rpx;
    bottom: -5%;
    right: -5%;
    background: rgba(79, 192, 141, 0.1);
  }