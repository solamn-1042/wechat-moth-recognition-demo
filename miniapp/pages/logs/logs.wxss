.container {
    min-height: 100vh;
    background: linear-gradient(to bottom, #f6f9f8, #e9f3ef);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 30rpx 30rpx;
    box-sizing: border-box;
  }
  
  .header {
    width: 100%;
    padding: 60rpx 0 24rpx 0;
    background: #4fc08d;
    text-align: center;
    border-radius: 0 0 32rpx 32rpx;
    margin-bottom: 80rpx;
    box-shadow: 0 4rpx 20rpx rgba(79, 192, 141, 0.3);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
  }
  
  .title {
    font-size: 44rpx;
    color: #fff;
    font-weight: bold;
    letter-spacing: 2rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  }
  
  /* 装饰元素 */
  .decorative-circle {
    position: absolute;
    background: rgba(79, 192, 141, 0.15);
    border-radius: 50%;
    z-index: 1;
  }
  
  .circle-1 {
    width: 200rpx;
    height: 200rpx;
    top: 10%;
    left: 10%;
  }
  
  .circle-2 {
    width: 300rpx;
    height: 300rpx;
    bottom: -5%;
    right: -5%;
    background: rgba(79, 192, 141, 0.1);
  }
  
  /* 未登录状态样式 */
  .login-container {
    width: 100%;
    margin-top: 180rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }
  
  .login-prompt {
    width: 85%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #ffffff;
    border-radius: 24rpx;
    padding: 60rpx 40rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  }
  
  .login-text {
    font-size: 32rpx;
    color: #666;
    margin-bottom: 40rpx;
  }
  
  /* 已登录状态用户信息卡片 */
  .user-container {
    width: 100%;
    margin-top: 180rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
  }
  
  .user-card {
    width: 85%;
    background: #ffffff;
    border-radius: 24rpx;
    padding: 40rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
  }
  
  .avatar-container {
    position: relative;
    width: 150rpx;
    height: 150rpx;
    margin-right: 30rpx;
  }
  
  .avatar {
    width: 150rpx;
    height: 150rpx;
    border-radius: 75rpx;
    border: 4rpx solid #4fc08d;
  }
  
  .avatar-edit {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50rpx;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 0 75rpx 75rpx;
  }
  
  .avatar-edit-text {
    color: #ffffff;
    font-size: 22rpx;
  }
  
  .user-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .nickname {
    font-size: 38rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 10rpx;
  }
  
  .username {
    font-size: 28rpx;
    color: #666;
  }
  
  /* 菜单列表 */
  .menu-list {
    width: 85%;
    background: #ffffff;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
    overflow: hidden;
    margin-bottom: 40rpx;
  }
  
  .menu-item {
    height: 110rpx;
    display: flex;
    align-items: center;
    padding: 0 40rpx;
    position: relative;
  }
  
  .menu-item:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 40rpx;
    right: 40rpx;
    bottom: 0;
    height: 1rpx;
    background: #f2f2f2;
  }
  
  .menu-text {
    flex: 1;
    font-size: 32rpx;
    color: #333;
  }
  
  .menu-arrow {
    font-size: 36rpx;
    color: #999;
    font-weight: bold;
  }
  
  /* 按钮样式 */
  .buttons {
    width: 85%;
    margin-top: 40rpx;
  }
  
  .submit-btn {
    width: 100%;
    height: 92rpx;
    background: linear-gradient(135deg, #4fc08d, #3da677);
    color: #fff;
    border-radius: 46rpx;
    font-size: 32rpx;
    margin-bottom: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 2rpx;
    box-shadow: 0 6rpx 12rpx rgba(79, 192, 141, 0.2);
    transition: all 0.3s ease;
    font-weight: 500;
  }
  
  .submit-btn:active {
    transform: translateY(2rpx);
    box-shadow: 0 2rpx 8rpx rgba(79, 192, 141, 0.2);
  }
  
  .logout-btn {
    width: 100%;
    height: 92rpx;
    background: #fff;
    color: #4fc08d;
    border: 2rpx solid #4fc08d;
    border-radius: 46rpx;
    font-size: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .logout-btn:active {
    background: #f7f9f8;
  }
  
  /* 弹窗样式 */
  .modal {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .modal-mask {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  
  .modal-content {
    width: 85%;
    background: #ffffff;
    border-radius: 24rpx;
    overflow: hidden;
    position: relative;
    z-index: 1001;
  }
  
  .modal-header {
    padding: 30rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1rpx solid #f2f2f2;
  }
  
  .modal-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
  }
  
  .modal-close {
    font-size: 48rpx;
    color: #999;
    line-height: 48rpx;
    width: 48rpx;
    height: 48rpx;
    text-align: center;
  }
  
  .modal-body {
    padding: 30rpx;
  }
  
  .form-group {
    margin-bottom: 30rpx;
    position: relative;
  }
  
  .label {
    display: block;
    font-size: 28rpx;
    color: #555;
    margin-bottom: 16rpx;
    font-weight: 500;
  }
  
  .input {
    width: 100%;
    height: 92rpx;
    background: #f7f9f8;
    border-radius: 16rpx;
    padding: 0 28rpx;
    box-sizing: border-box;
    font-size: 30rpx;
    border: 1rpx solid #eaeaea;
    transition: all 0.3s ease;
  }
  
  .input:focus {
    border-color: #4fc08d;
    box-shadow: 0 0 0 2rpx rgba(79, 192, 141, 0.2);
  }
  
  .modal-footer {
    display: flex;
    border-top: 1rpx solid #f2f2f2;
  }
  
  .modal-cancel, .modal-confirm {
    flex: 1;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    border-radius: 0;
  }
  
  .modal-cancel {
    background: #ffffff;
    color: #666;
  }
  
  .modal-confirm {
    background: #4fc08d;
    color: #ffffff;
  }